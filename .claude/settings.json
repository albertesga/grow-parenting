{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl -s -o /dev/null -w * http://localhost:5050/*)",
      "Bash(curl -s -o /dev/null -w * \"http://localhost:5050/design/*\")",
      "Bash(node --check *)",
      "Bash(node -c *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(ls *)",
      "Bash(wc -l *)",
      "Bash(wc *)",
      "Bash(python3 -c *)",
      "Bash(cat /tmp/*)",
      "Bash(echo *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/post-edit-verify.sh"
      }
    ]
  }
}
