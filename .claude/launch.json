{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grow-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5050"],
      "port": 5050
    },
    {
      "name": "grow-homepage",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5051", "--directory", "homepage"],
      "port": 5051
    },
    {
      "name": "homepage-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/preview-server.cjs"],
      "port": 5052
    },
    {
      "name": "about-us",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "apps/about-us",
      "port": 3000,
      "autoPort": true
    }
  ]
}
